{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(git *)",
      "Bash(ssh *@* journalctl *)",
      "Bash(ssh *@* \"journalctl *)",
      "Bash(ssh *@* 'journalctl *)",
      "WebSearch",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.cwd | split(\"/\") | last' | xargs -I {} notify-send '[cc:{}]' 'Task completed' --icon=emblem-default"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.cwd | split(\"/\") | last' | xargs -I {} notify-send '[cc:{}]' 'Permission required' --icon=dialog-warning"
          }
        ]
      }
    ]
  },
  "model": "sonnet"
}
